# Configuração de Ambiente do JIF+ (Exemplo sem segredos)
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.

# Ambiente (development / production)
APP_ENV=development
APP_NAME="JIF+ Gestão e Inteligência Esportiva"
APP_URL=http://localhost/4°Bim%20-%20Arthur%20Gimax%20-%20JIF+

# Conexão com o Banco de Dados MySQL / MariaDB (InnoDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jif_plus
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Chave de segurança para sessões
SESSION_SECRET=jifplus_chave_secreta_academica_2026_ifro
