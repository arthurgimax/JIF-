# JIF+ — modelo seguro de configuração local
# Copie para .env no seu computador. Nunca envie .env ao GitHub.
APP_ENV=development
APP_NAME="JIF+ Gestão e Inteligência Esportiva"
APP_URL=http://localhost:8000

# XAMPP / MySQL local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jif_plus
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Em produção, configure estes valores no painel do provedor (não use os dados locais):
# APP_ENV=production
# DB_HOST=HOST_MYSQL_FORNECIDO_PELO_PROVEDOR
# DB_PORT=3306
# DB_NAME=NOME_DO_BANCO_FORNECIDO_PELO_PROVEDOR
# DB_USER=USUARIO_DO_BANCO_FORNECIDO_PELO_PROVEDOR
# DB_PASS=SENHA_DO_BANCO_FORNECIDA_PELO_PROVEDOR